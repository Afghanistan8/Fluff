# Address of the deployed Fluff contract.
VITE_FLUFF_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Which GenLayer network to talk to: `bradbury`, `studionet` or `studiodev`.
# This selects the RPC endpoint and the chain id together, so pointing the client
# at a redeployed contract on the other network is this one line plus the address.
VITE_GENLAYER_NETWORK=bradbury

# Informational only. The network above decides the chain id.
#   bradbury  -> 4221
#   studionet -> 61999
#   studiodev -> 61997
VITE_GENLAYER_CHAIN_ID=4221
